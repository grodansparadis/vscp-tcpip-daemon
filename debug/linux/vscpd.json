{
  "_comment": "VSCP tcp/ip Daemon configuration file — JSON format",
  "_docs": "https://docs.vscp.org/vscpd/15.0/#/configuring_the_vscp_daemon",
  "runasuser": "vscp",
  "debug": 0,
  "guid": "-",
  "servername": "The VSCP daemon",
  "classtypedb": "/var/lib/vscp/vscpd/vscp_events.sqlite3",
  "maindb": "/var/lib/vscp/vscpd/vscp.sqlite3",
  "discoverydb": "/var/lib/vscp/vscpd/vscp.sqlite3",
  "vscpkey": "/etc/vscp/vscp.key",

  "logging": {
    "file-enable-log": true,
    "file-log-level": "trace",
    "file-pattern": "[vscpd: %c] [%^%l%$] %v",
    "file-path": "/tmp/vscpd.log",
    "file-max-size": 5242880,
    "file-max-files": 7,
    "console-enable-log": true,
    "console-log-level": "trace",
    "console-pattern": "[vscpd: %c] [%^%l%$] %v",
    "syslog-enable-log" : true,
    "syslog-log-level" : "info",
    "syslog-ident" : "mqttvscpd",
    "udp-enable-log": true,
    "udp-log-level" : "info",
    "udp-pattern" : "[mqttvscpd] [%^%l%$] %v",
    "udp-host" : "127.0.0.1",
    "udp-port" : 9999
  },

  "users": [
    {
      "username": "admin",
      "_comment_password": "Password is stored hashed using Argon2",
      "password": "admin",
      "fullname": "admin",
      "_comment_remotes": "List of remote connections for this user",
      "remotes": [],
      "_comment_events": "List of events this user can send",
      "events": []
    }
  ],


  "tcpip": {
    "interface-address": "127.0.0.1:9598",
    "_comment": "If ssl is used, configure the SSL options below otherwise remove this section",
    "ssl-options": {
      "cafile": "",
      "certfile": "",
      "keyfile": "",
      "name": ""
    }
  },

  "drivers": {
    "level1": [
      {
        "enable": false,
        "name": "logger",
        "config": "/tmp/canallog.txt",
        "flags": 1,
        "translation": 2,
        "path": "/var/lib/vscp/drivers/level1/vscpl1drv-logger.so",
        "guid": "FF:FF:FF:FF:FF:FF:FF:F5:01:00:00:00:00:00:00:00"        
      }
    ],
    "level2": [
      {
        "enable": false,
        "name": "lmsensors",
        "path-driver": "/var/lib/vscp/drivers/level2/vscpl2drv-lmsensors.so",
        "path-config": "/var/lib/vscp/vscpd/lmsensors.json",
        "guid": "FF:FF:FF:FF:FF:FF:FF:F5:02:00:00:00:00:00:00:02"
      },
      {
        "enable": false,
        "name": "socketcan",
        "path-driver": "/var/lib/vscp/drivers/level2/vscpl2drv-socketcan.so",
        "path-config": "/var/lib/vscp/vscpd/socketcan.json",
        "guid": "FF:FF:FF:FF:FF:FF:FF:F5:02:00:00:00:00:00:00:03"
      },
      {
        "enable": false,
        "name": "tcpiplink",
        "path-driver": "/var/lib/vscp/drivers/level2/vscpl2drv-tcpiplink.so",
        "path-config": "/var/lib/vscp/vscpd/tcpiplink.json",
        "guid": "FF:FF:FF:FF:FF:FF:FF:F5:02:00:00:00:00:00:00:05"
      },
      {
        "enable": false,
        "name": "sim",
        "path-driver": "/var/lib/vscp/drivers/level2/vscpl2drv-sim.so",
        "path-config": "/var/lib/vscp/vscpd/sim.json",
        "guid": "FF:FF:FF:FF:FF:FF:FF:F5:02:00:00:00:00:00:00:07"
      }
    ]
  }
}
